PORT=3000

# Supabase direct connection (port 5432). Replace the password.
# If your network cannot reach the direct host, use the Supabase pooler URL instead.
DATABASE_URL=postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.djwoxwxugifytgytxovs.supabase.co:5432/postgres
DATABASE_SSL=true

# Set to false to skip migrations when the API process starts.
DB_MIGRATE_ON_START=true
DB_LOGGING=false

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Optional. When unset, product reads skip the cache and hit PostgreSQL.
# REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=60

# Login is limited per network address and per email. Other routes share a higher cap.
# LOGIN_RATE_LIMIT=30
# LOGIN_RATE_WINDOW_SECONDS=900
# LOGIN_EMAIL_RATE_LIMIT=20
# LOGIN_EMAIL_RATE_WINDOW_SECONDS=900
# API_RATE_LIMIT=300
# API_RATE_WINDOW_SECONDS=60
