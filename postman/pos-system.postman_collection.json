{
  "info": {
    "name": "Multi-tenant POS",
    "description": "Sales, inventory, and tenant isolation for the POS API. Run the seed script first. Every demo user uses password Password123!. Amounts are integer paise.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "storeId", "value": "11111111-1111-4111-8111-111111111101" },
    { "key": "otherStoreId", "value": "11111111-1111-4111-8111-111111111102" },
    { "key": "merchantBStoreId", "value": "22222222-2222-4222-8222-222222222203" },
    { "key": "productId", "value": "11111111-1111-4111-8111-111111111301" },
    { "key": "foreignProductId", "value": "22222222-2222-4222-8222-222222222304" },
    { "key": "idempotencyKey", "value": "sale-demo-001" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login store 1 cashier",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.accessToken);",
                  "if (body.user && body.user.storeId) {",
                  "  pm.collectionVariables.set('storeId', body.user.storeId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cashier.store1@pos.test\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login merchant A admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin.a@pos.test\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "List my stores",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/stores"
          }
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/stores/{{storeId}}/products"
          }
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('productId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Espresso\",\n  \"sku\": \"ESPRESSO\",\n  \"priceCents\": 2800,\n  \"initialQuantity\": 20\n}"
            },
            "url": "{{baseUrl}}/stores/{{storeId}}/products"
          }
        },
        {
          "name": "List inventory",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/stores/{{storeId}}/inventory"
          }
        },
        {
          "name": "Receive stock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"delta\": 5\n}"
            },
            "url": "{{baseUrl}}/stores/{{storeId}}/inventory/adjustments"
          }
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        {
          "name": "Create sale",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 1 }\n  ],\n  \"paymentOutcome\": \"SUCCESS\"\n}"
            },
            "url": "{{baseUrl}}/stores/{{storeId}}/sales"
          }
        },
        {
          "name": "Retry the same sale",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 1 }\n  ],\n  \"paymentOutcome\": \"SUCCESS\"\n}"
            },
            "url": "{{baseUrl}}/stores/{{storeId}}/sales"
          }
        },
        {
          "name": "Failed payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 1 }\n  ],\n  \"paymentOutcome\": \"FAILED\"\n}"
            },
            "url": "{{baseUrl}}/stores/{{storeId}}/sales"
          }
        },
        {
          "name": "List sales",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/stores/{{storeId}}/sales"
          }
        },
        {
          "name": "List orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/stores/{{storeId}}/orders"
          }
        }
      ]
    },
    {
      "name": "Tenant checks",
      "item": [
        {
          "name": "Login merchant B cashier",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cashier.store3@pos.test\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Merchant B cannot read Merchant A products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/stores/{{storeId}}/products"
          }
        },
        {
          "name": "Sale with another merchant product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 1 }\n  ],\n  \"paymentOutcome\": \"SUCCESS\"\n}"
            },
            "url": "{{baseUrl}}/stores/{{merchantBStoreId}}/sales"
          }
        }
      ]
    }
  ]
}
